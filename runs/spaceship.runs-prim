# The Processors the spaceship Networks of spaceship.runs fire.

processor take_first_controls                               # dio \scw
  reads: handoff
  writes: spaceship
  set spaceship.controls = handoff.control_word

# The second ship's bits are the low four; rotating them up makes them
# read as the first ship's.
processor take_second_controls                              # rir 4s; dio \scw
  reads: handoff
  writes: spaceship
  set spaceship.controls = rar(handoff.control_word, 4)

# Rotation. With sense switch 1 on, the rotate buttons work through angular
# momentum, which builds up; otherwise they turn the ship directly, faster.
# The rocket fires while its button is held and fuel is left.
processor steer(slot)                                       # sc1
  reads: tunables, console
  writes: spaceship, ship_flight, sine_call
  let controls = spaceship.controls
  set spaceship.rocket = off
  let turn = 0
  if controls < 0:                                          # rotate counterclockwise
    set turn = turn + tunables.angular_acceleration
  set controls = ral(controls, 1)
  if controls < 0:                                          # rotate clockwise
    set turn = turn - tunables.angular_acceleration
  set turn = turn + ship_flight.angular_momentum[slot]
  set ship_flight.angular_momentum[slot] = turn
  if console.angular_momentum == off:                       # szs 10
    set ship_flight.angular_momentum[slot] = 0
    set turn = ral(turn, 7)
  set controls = ral(controls, 1)
  if controls < 0:                                          # the rocket button
    set spaceship.rocket = firing
  if ship_flight.fuel[slot] >= 0:                                 # out of fuel
    set spaceship.rocket = off
  let angle = turn + ship_flight.angle[slot]
  if angle >= 0:                                            # keep the heading within a turn
    set angle = angle - 0311040
  if angle < 0:
    set angle = angle + 0311040
  set ship_flight.angle[slot] = angle
  set sine_call.angle = angle

processor take_sine                                         # dac \sn; dzm \bx; dzm \by
  reads: sine_call
  writes: spaceship, heading
  set heading.sine = sine_call.result
  set spaceship.gravity_x = 0
  set spaceship.gravity_y = 0

# Gravity. Each coordinate is scaled down by 2^11 and squared.
processor square_x(slot)                                    # lac i mx1; sar 9s; sar 2s
  reads: objects
  writes: spaceship, integer_multiply_call
  set spaceship.operand = objects.x[slot] >> 11
  set integer_multiply_call.entry = spaceship.operand
  set integer_multiply_call.factor = spaceship.operand

processor square_y(slot)
  reads: objects
  writes: spaceship, integer_multiply_call
  set spaceship.x_squared = integer_multiply_call.product
  set spaceship.operand = objects.y[slot] >> 11
  set integer_multiply_call.entry = spaceship.operand
  set integer_multiply_call.factor = spaceship.operand

processor measure_capture                                   # add \t2; sub str
  reads: integer_multiply_call, spaceship, tunables
  writes: handoff
  set handoff.capture_margin = integer_multiply_call.product + spaceship.x_squared - tunables.star_capture_radius

processor take_root                                         # add str; dac \t1; jda sqt
  reads: handoff, tunables
  writes: spaceship, square_root_call
  set spaceship.operand = handoff.capture_margin + tunables.star_capture_radius
  set square_root_call.entry = spaceship.operand

processor cube_distance                                     # sar 9s; jda mpy / lac \t1
  reads: square_root_call, spaceship
  writes: multiply_call
  set multiply_call.entry = square_root_call.root >> 9
  set multiply_call.factor = spaceship.operand

# Sense switch 2 makes the star light: the distance is scaled down less.
processor scale_distance                                    # scr 2s; szs i 20; scr 2s
  reads: multiply_call, console
  writes: handoff
  set handoff.distance_high = multiply_call.partial
  set handoff.distance_low = multiply_call.low
  set (handoff.distance_high, handoff.distance_low) = scr(handoff.distance_high, handoff.distance_low, 2)
  if console.light_star == off:
    set (handoff.distance_high, handoff.distance_low) = scr(handoff.distance_high, handoff.distance_low, 2)

# The pull: minus the position over the distance cubed. The second divide
# takes in IO what the first left there, its remainder.
processor aim_pull_x(slot)                                  # dio \t1; lac i mx1; cma; jda idv
  reads: handoff, objects
  writes: spaceship, integer_divide_call
  set spaceship.operand = handoff.distance_low
  set integer_divide_call.dividend = -objects.x[slot]
  set integer_divide_call.low = handoff.distance_low
  set integer_divide_call.divisor = spaceship.operand

processor aim_pull_y(slot)                                  # dac \bx; lac i my1; cma; jda idv
  reads: divide_call, objects
  writes: spaceship, integer_divide_call
  set spaceship.gravity_x = divide_call.result
  set integer_divide_call.dividend = -objects.y[slot]
  set integer_divide_call.low = divide_call.high
  set integer_divide_call.divisor = spaceship.operand

processor take_pull_y                                       # dac \by
  reads: divide_call
  writes: spaceship
  set spaceship.gravity_y = divide_call.result

# The thrust: the heading's cosine and sine, each scaled by the tunable sac,
# while the rocket fires; the pull adds to it.
processor check_fuel(slot)                                  # cla; sad i \mfu; clf 6
  reads: ship_flight
  writes: spaceship, cosine_call
  if 0 == ship_flight.fuel[slot]:
    set spaceship.rocket = off
  set cosine_call.angle = ship_flight.angle[slot]

processor aim_thrust_y                                      # dac \cs; sar 9s
  reads: sine_call
  writes: handoff, heading
  set heading.cosine = sine_call.result
  set handoff.thrust_direction = heading.cosine >> 9

processor push_y                                            # szf i 6; cla; add \by
  reads: spaceship
  writes: handoff
  let push = handoff.thrust
  if spaceship.rocket == off:
    set push = 0
  set handoff.acceleration = push + spaceship.gravity_y

processor aim_thrust_x                                      # lac \sn; sar 9s
  reads: heading
  writes: handoff
  set handoff.thrust_direction = heading.sine >> 9

processor push_x                                            # cma; szf i 6; cla; add \bx
  reads: spaceship
  writes: handoff
  let push = -handoff.thrust
  if spaceship.rocket == off:
    set push = 0
  set handoff.acceleration = push + spaceship.gravity_x

# The outline starts at the tip, a 32nd of the heading ahead, and a torpedo
# starts as far again.
processor aim_nose(slot)                                    # sp1, sp2
  reads: objects, heading
  writes: spaceship, ship_nose
  set spaceship.nose_step_x = heading.sine >> 5
  set spaceship.nose_step_y = heading.cosine >> 5
  set ship_nose.x = objects.x[slot] - spaceship.nose_step_x
  set spaceship.torpedo_x = ship_nose.x - spaceship.nose_step_x
  set ship_nose.y = objects.y[slot] + spaceship.nose_step_y
  set spaceship.torpedo_y = ship_nose.y + spaceship.nose_step_y

processor aim_outline                                       # .. sp5
  reads: ship_nose, heading
  writes: pen
  set pen.x = ship_nose.x
  set pen.y = ship_nose.y
  set pen.down_x = heading.sine >> 9
  set pen.down_y = heading.cosine >> 9
  set pen.out_y = pen.down_x
  set pen.out_down_x = pen.out_y + pen.down_y
  set pen.in_down_y = pen.out_down_x
  set pen.in_down_x = pen.down_x - pen.down_y
  set pen.out_down_y = -pen.in_down_x
  set pen.out_x = pen.down_y

# A dot at the center, before the outline: on the PDP-1 it asks the display
# for the completion pulse that the outline's first dot waits for.
processor mark_center                                       # cla cli; dpy-4000
  writes: display
  emit display: 0, 0, 0

# The ship's outline, its strokes from ship_outlines.outline[slot], which the main
# loop loads into the jump as it reaches the ship's slot. Each step moves
# the pen and plots a dot, from the nose down one side to the end; then the
# out steps are mirrored and the same strokes draw the other side, from the
# nose again. The pen is left at the tail, and the walk goes back to sq6.
processor draw_outline                                      # sp5, jmp .
  in start: word
  in strokes: stroke[0304]
  in backs: word[0304]
  in down_x: word
  in down_y: word
  inout x: word
  inout y: word
  inout out_x: word
  inout out_y: word
  inout out_down_x: word
  inout out_down_y: word
  inout in_down_x: word
  inout in_down_y: word
  inout saved_x: word
  inout saved_y: word
  inout side: side
  inout point_x: word
  inout point_y: word
  inout points: display
  let at = start
  let drawing = going
  for stroke_count in 1 .. 0304:
    if drawing == going:
      let stroke = strokes[at]
      if stroke == begin:
        set side = first                                  # stf 5
      elif stroke == nose:
        set point_x = x                             # lac \sx1
        set point_y = y                             # lio \sy1
      elif stroke == down:
        set point_x = point_x + down_x
        set (point_x, point_y) = rcl(point_x, point_y, 18)   # swap: only AC adds
        set point_x = point_x - down_y
        set (point_x, point_y) = rcl(point_x, point_y, 18)
        emit points: point_x, point_y, 0
      elif stroke == out:
        set point_x = point_x + out_x
        set (point_x, point_y) = rcl(point_x, point_y, 18)   # swap: only AC adds
        set point_x = point_x + out_y
        set (point_x, point_y) = rcl(point_x, point_y, 18)
        emit points: point_x, point_y, 0
      elif stroke == out_down:
        set point_x = point_x + out_down_x
        set (point_x, point_y) = rcl(point_x, point_y, 18)   # swap: only AC adds
        set point_x = point_x - out_down_y
        set (point_x, point_y) = rcl(point_x, point_y, 18)
        emit points: point_x, point_y, 0
      elif stroke == in:
        set point_x = point_x - out_x
        set (point_x, point_y) = rcl(point_x, point_y, 18)   # swap: only AC adds
        set point_x = point_x - out_y
        set (point_x, point_y) = rcl(point_x, point_y, 18)
        emit points: point_x, point_y, 0
      elif stroke == in_down:
        set point_x = point_x + in_down_x
        set (point_x, point_y) = rcl(point_x, point_y, 18)   # swap: only AC adds
        set point_x = point_x - in_down_y
        set (point_x, point_y) = rcl(point_x, point_y, 18)
        emit points: point_x, point_y, 0
      elif stroke == store:
        set saved_x = point_x
        set saved_y = point_y
      elif stroke == restore:
        set point_x = saved_x
        set point_y = saved_y
      elif stroke == end:
        if side == other:                                 # szf 5
          set x = point_x                           # the tail, where the flame starts
          set y = point_y
          set drawing = done                                # jmp sq6
        if drawing == going:
          set side = other                                  # clf 5: the other side
          # The point is spent: AC and IO carry the mirror's words.
          set point_x = -out_x                        # out is in
          set out_x = point_x
          set point_x = -out_y
          set out_y = point_x
          set point_x = out_down_y                    # out and down is in and down
          set point_y = in_down_y
          set in_down_y = point_x
          set out_down_y = point_y
          set point_x = out_down_x
          set point_y = in_down_x
          set in_down_x = point_x
          set out_down_x = point_y
          set at = backs[at]                        # the nose again
      if stroke != end:
        set at = at + 1

# The exhaust flame (network exhaust). How many dots, whether the rocket
# fires, and the fuel each dot burns are the game's; the dots are the
# presentation's.
processor light_flame                                       # sq6: ranct sar 9s, sar 4s, \src
  reads: random
  writes: spaceship, handoff
  let dots = random.number >> 13
  if dots >= 0:
    set dots = -dots
  set spaceship.flame = dots
  set handoff.rocket_button = spaceship.controls            # lio \scw
  set handoff.rocket_button = ral(handoff.rocket_button, 2)

processor aim_flame                                         # sq7: scale \sn, 8s, \ssn
  reads: heading
  writes: pen
  set pen.down_x = heading.sine >> 8
  set pen.down_y = heading.cosine >> 8

processor burn_fuel(slot)                                   # count i \mfu, st2
  writes: ship_flight
  set ship_flight.fuel[slot] = ship_flight.fuel[slot] + 1

processor empty_tank(slot)                                  # dzm i \mfu
  writes: ship_flight
  set ship_flight.fuel[slot] = 0

processor plot_flame                                        # st2: yincr \sx1, \sy1, sub; dispt i, \sy1
  writes: pen, display
  set pen.y = pen.y - pen.down_y
  set pen.x = pen.x + pen.down_x
  emit display: pen.x, pen.y, 0

processor count_flame                                       # count \src, sq7
  writes: spaceship
  set spaceship.flame = spaceship.flame + 1

# Torpedoes. The counter is the tube's reload time. The fire button
# launches while held; with sense switch 3 on, only when newly pressed. The
# previous control word is never stored, so it is always newly pressed.
processor trigger(slot)                                     # dzm i ma1; mco, lac .
  reads: ships, console, spaceship
  writes: objects, handoff
  set objects.counter[slot] = 0                             # prevent count around
  let fire = -ships.previous_control[slot]
  if console.single_shot == off:
    set fire = -0                                           # clc
  set fire = fire & spaceship.controls
  set handoff.torpedo_button = ral(fire, 3)                 # the torpedo bit to the sign

processor count_torpedo(slot)
  writes: ship_flight
  set ship_flight.torpedoes[slot] = ship_flight.torpedoes[slot] + 1

processor out_of_torpedoes(slot)                            # dzm i \mtr: prevent count around
  writes: ship_flight
  set ship_flight.torpedoes[slot] = 0

processor first_slot
  writes: launch
  set launch.slot = 0

processor next_slot
  writes: launch
  set launch.slot = launch.slot + 1

processor place_torpedo                                     # sr2
  reads: launch, spaceship, heading
  writes: objects, handoff
  set objects.routine[launch.slot] = torpedo
  set objects.x[launch.slot] = spaceship.torpedo_x
  set objects.y[launch.slot] = spaceship.torpedo_y
  set handoff.torpedo_direction = heading.sine

processor take_torpedo_dx(slot)
  reads: launch, heading
  writes: objects, handoff
  set objects.dx[launch.slot] = -handoff.torpedo_velocity + objects.dx[slot]
  set handoff.torpedo_direction = heading.cosine

processor take_torpedo_dy(slot)
  reads: launch, handoff
  writes: objects
  set objects.dy[launch.slot] = handoff.torpedo_velocity + objects.dy[slot]

processor reload_tube(slot)                                 # dac i ma1: the tube cools
  reads: handoff
  writes: objects
  set objects.counter[slot] = handoff.reload_time

# The torpedo calc's length goes into the address part of its time word
# (law 20; dap); the rest of the word stays.
processor arm_torpedo                                       # trf
  reads: launch, handoff
  writes: objects
  set objects.counter[launch.slot] = handoff.torpedo_life
  set objects.cycles[launch.slot] = objects.cycles[launch.slot] & 0770000 | 020

# Hyperspace: the hyperfield generators recharge, counting up. The ship's
# calc routine is kept while in_hyperspace runs instead.
processor count_recharge(slot)
  writes: ships
  set ships.recharge[slot] = ships.recharge[slot] + 1

processor recharged(slot)                                   # dzm i \mh3
  writes: ships
  set ships.recharge[slot] = 0

# The rotate buttons not newly pressed: 0 when both are pressed now and
# neither was last frame.
processor hyperspace_buttons(slot)                          # lac \scw; cma; ior i mco; and (600000
  reads: spaceship, ships
  writes: handoff
  set handoff.hyperspace_buttons = (-spaceship.controls | ships.previous_control[slot]) & 0600000

processor enter_hyperspace(slot)                            # sr5
  writes: ships, objects
  set ships.saved_routine[slot] = objects.routine[slot]
  set objects.routine[slot] = in_hyperspace

processor time_hyperspace(slot)                             # dac i ma1; law 3; dac i mb1
  reads: handoff
  writes: objects
  set objects.counter[slot] = handoff.hyperspace_time
  set objects.cycles[slot] = 3

