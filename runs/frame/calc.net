# The calc routine the object's routine word names (mq4: lac i ml1;
# dap . 1; jsp .), a bundle: an n-way test on the routine word, which jumps
# through it. A free slot runs no calc routine. Each reads and gives the
# table, the generator and the ships.

network calc(slot)
  assumes: table[slot].routine != none
  inout table: objects
  inout seed: random
  inout fleet: ships
  inout points: display
  in switches: console
  inout flight: ship_flight
  inout brush: pen

transitions
  first: first_spaceship(slot)                              # ss1
  second: second_spaceship(slot)                            # ss2
  flying: torpedo(slot)                                     # tcr
  exploding: explosion(slot)                                # mex
  away: in_hyperspace(slot)                                 # hp1
  back: breakout(slot)                                      # hp3

arcs
  table[slot].routine -> first when == first_spaceship
  switches -> first.switches
  table -> first.table
  first.table -> table
  points -> first.points
  first.points -> points
  seed -> first.seed
  first.seed -> seed
  fleet -> first.crew
  first.crew -> fleet
  flight -> first.fleet
  first.fleet -> flight
  brush -> first.brush
  first.brush -> brush
  table[slot].routine -> second when == second_spaceship
  switches -> second.switches
  table -> second.table
  second.table -> table
  points -> second.points
  second.points -> points
  seed -> second.seed
  second.seed -> seed
  fleet -> second.crew
  second.crew -> fleet
  flight -> second.fleet
  second.fleet -> flight
  brush -> second.brush
  second.brush -> brush
  table[slot].routine -> flying when == torpedo
  table -> flying.table
  flying.table -> table
  points -> flying.points
  flying.points -> points
  table[slot].routine -> exploding when == explosion
  table -> exploding.table
  exploding.table -> table
  points -> exploding.points
  exploding.points -> points
  seed -> exploding.seed
  exploding.seed -> seed
  table[slot].routine -> away when == in_hyperspace
  table -> away.table
  away.table -> table
  points -> away
  away -> points
  seed -> away.seed
  away.seed -> seed
  table[slot].routine -> back when == breakout
  table -> back.table
  back.table -> table
  points -> back.points
  back.points -> points
  fleet -> back.fleet
  back.fleet -> fleet
  seed -> back.seed
  back.seed -> seed
