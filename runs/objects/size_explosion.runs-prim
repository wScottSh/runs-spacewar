# The count is the game's: one dot per 8 instructions of the object's size.
# The cma clears IO as it goes (cli): the first dot's shifts push that out.
processor size_explosion
  in cycles: word
  out particles: word
  out low: word
  let size = cycles                                         # lac i mb1
  set size = -size                                          # cma cli: one instruction
  set low = 0
  set particles = size >> 3
