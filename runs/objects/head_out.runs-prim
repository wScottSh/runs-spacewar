processor head_out(slot)
  requires: slot < 2
  reads: handoff, random
  writes: objects, ship_flight
  set objects.dy[slot] = handoff.jump_high
  set objects.dx[slot] = handoff.jump_low
  let angle_steps = -3
  set ship_flight.angle[slot] = random.number
  for pass in 1 .. -angle_steps:    # bring the new heading within a turn
    let heading = ship_flight.angle[slot]
    if heading >= 0:
      set heading = heading - 0311040
    if heading < 0:
      set heading = heading + 0311040
    set ship_flight.angle[slot] = heading
    set angle_steps = angle_steps + 1
