# The ship leaves with the scaled draw as its velocity and a random
# turned, brought within a turn.
processor head_out
  in high: word
  in low: word
  in number: word
  out dy: word
  out dx: word
  out angle: word
  set dy = high
  set dx = low
  let angle_steps = -3
  set angle = number
  for pass in 1 .. -angle_steps:    # bring the new turned within a turn
    let turned = angle
    if turned >= 0:
      set turned = turned - 0311040
    if turned < 0:
      set turned = turned + 0311040
    set angle = turned
    set angle_steps = angle_steps + 1
