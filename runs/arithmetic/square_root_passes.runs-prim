# BBN integer square root's passes (sqt). Binary point right of bit 17 in the
# argument, between bits 8 and 9 in the root. Two bits of input per pass, 18
# passes: passes_left counts up from -022 to 0, one pass a count. The
# argument comes in as remainder, which leaves as what is left of it.
processor square_root_passes
  inout remainder: word
  out root: word
  out passes_left: word
  set passes_left = -023
  set root = 0
  let input_bits = remainder
  set remainder = 0
  set passes_left = passes_left + 1
  if passes_left < 0:
    for pass in 1 .. -passes_left:
      set root = root << 1
      let next = remainder
      set (next, input_bits) = rcl(next, input_bits, 2)
      if next != 0:
        set remainder = next
        set next = (root << 1) + 1 - remainder
        if next <= 0:
          if next < 0:
            set next = -next
          set remainder = next
          set root = root + 1
      set passes_left = passes_left + 1
