# sine (sin), a bundle. The angle is folded into [0, pi/2] and scaled by
# 2/pi to x; the answer is the odd series x (C1 + x^2 (C3 + x^2 (C5 + x^2 C7))),
# each product the high half of a multiply, shifted up by 3 at the end. When
# the series overshoots +-1, the answer is +-1 signed like x.

network sine
  in angle: word
  out result: word

places
  sine_work.reduced
  sine_work.two_over_pi
  sine_work.x
  sine_work.x_low
  sine_work.x_squared
  sine_work.x_squared_low
  sine_work.c7
  sine_work.term_7
  sine_work.term_7_low
  sine_work.sum_5
  sine_work.term_5
  sine_work.term_5_low
  sine_work.sum_3
  sine_work.term_3
  sine_work.term_3_low
  sine_work.sum_1
  sine_work.term_1
  sine_work.term_1_low
  sine_work.answer
  sine_work.overshoot

transitions
  reduce: reduce_angle
  scale: two_over_pi
  times_scale: multiply
  square: multiply
  seven: sine_c7
  times_7: multiply
  add_5: add_sine_c5
  times_5: multiply
  add_3: add_sine_c3
  times_3: multiply
  add_1: add_sine_c1
  times_1: multiply
  scale_up: scale_up_3
  test_overshoot: exclusive_or
  saturate: saturate
  give_answer: copy

arcs
  angle -> reduce.angle
  reduce.reduced -> sine_work.reduced
  scale.value -> sine_work.two_over_pi
  sine_work.reduced -> times_scale.entry
  sine_work.two_over_pi -> times_scale.factor
  times_scale.partial -> sine_work.x
  times_scale.low -> sine_work.x_low
  sine_work.x -> square.entry
  sine_work.x -> square.factor
  square.partial -> sine_work.x_squared
  square.low -> sine_work.x_squared_low
  seven.value -> sine_work.c7
  sine_work.x_squared -> times_7.entry
  sine_work.c7 -> times_7.factor
  times_7.partial -> sine_work.term_7
  times_7.low -> sine_work.term_7_low
  sine_work.term_7 -> add_5.value
  add_5.sum -> sine_work.sum_5
  sine_work.sum_5 -> times_5.entry
  sine_work.x_squared -> times_5.factor
  times_5.partial -> sine_work.term_5
  times_5.low -> sine_work.term_5_low
  sine_work.term_5 -> add_3.value
  add_3.sum -> sine_work.sum_3
  sine_work.sum_3 -> times_3.entry
  sine_work.x_squared -> times_3.factor
  times_3.partial -> sine_work.term_3
  times_3.low -> sine_work.term_3_low
  sine_work.term_3 -> add_1.value
  add_1.sum -> sine_work.sum_1
  sine_work.sum_1 -> times_1.entry
  sine_work.x -> times_1.factor
  times_1.partial -> sine_work.term_1
  times_1.low -> sine_work.term_1_low
  sine_work.term_1 -> scale_up.high
  sine_work.term_1_low -> scale_up.low
  scale_up.scaled -> sine_work.answer
  sine_work.answer -> test_overshoot.a
  sine_work.x -> test_overshoot.b
  test_overshoot.result -> sine_work.overshoot
  sine_work.overshoot -> saturate when < 0
  sine_work.x -> saturate.like
  saturate.result -> result
  sine_work.overshoot -> give_answer when else
  sine_work.answer -> give_answer.source
  give_answer.target -> result
