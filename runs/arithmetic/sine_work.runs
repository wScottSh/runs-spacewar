# Every value sine computes on the way, each written once.
game record sine_work
  reduced: word = 0
  two_over_pi: word = 0
  x: word = 0               # sin's entry word: the angle reduced to [0, pi/2], times 2/pi
  x_low: word = 0
  x_squared: word = 0       # cos's entry word
  x_squared_low: word = 0
  c7: word = 0
  term_7: word = 0
  term_7_low: word = 0
  sum_5: word = 0
  term_5: word = 0
  term_5_low: word = 0
  sum_3: word = 0
  term_3: word = 0
  term_3_low: word = 0
  sum_1: word = 0
  term_1: word = 0
  term_1_low: word = 0
  answer: word = 0          # cos's entry word, last: the series' answer
  overshoot: word = 0
