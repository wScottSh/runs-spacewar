# The angle, within +-2 pi, folded into [0, pi/2] and shifted left 2 (sin ..
# si3). 062210 is pi/2 and 0311040 is 2 pi.
processor reduce_angle
  in angle: word
  out reduced: word
  let a = angle
  if a < 0:
    set a = a + 0311040                                     # si1
  let reducing = going
  for pass in 1 .. 2:                                       # two passes reduce every word (all 2^18 run)
    if reducing == going:
      set a = a - 062210
      if a < 0:
        set a = a + 062210
        set reducing = done
    if reducing == going:
      set a = -a + 062210                                   # si2: fold past pi/2 back
      if a >= 0:
        set reducing = done
    if reducing == going:
      set a = a + 062210
      if a >= 0:
        set a = a - 062210
        set reducing = done
    if reducing == going:
      set a = a - 062210
      set a = a + 0311040                                   # jmp si1
  set reduced = ral(a, 2)                                   # si3
