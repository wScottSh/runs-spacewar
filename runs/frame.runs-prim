# The main loop's own Processors.

processor use_test_word                                     # a1
  writes: controls
  set controls.source = test_word

processor use_control_boxes                                 # a40
  writes: controls
  set controls.source = control_boxes

processor post_scores
  reads: score
  writes: scoreboard
  emit scoreboard, score.first, score.second

processor clear_scores
  writes: score
  set score.first = 0
  set score.second = 0

processor clear_tables                                      # clear mtb, nnn-1
  writes: objects, ship_flight, ships
  for slot in 0 .. 027:
    set objects.routine[slot] = none
    set objects.x[slot] = 0
    set objects.y[slot] = 0
    set objects.counter[slot] = 0
    set objects.cycles[slot] = 0
    set objects.dx[slot] = 0
    set objects.dy[slot] = 0
  for ship in 0 .. 1:
    set ship_flight.angular_momentum[ship] = 0
    set ship_flight.angle[ship] = 0
    set ship_flight.fuel[ship] = 0
    set ship_flight.torpedoes[ship] = 0
    set ships.previous_control[ship] = 0
    set ships.saved_routine[ship] = none
    set ships.jumps_left[ship] = 0
    set ships.recharge[ship] = 0
    set ships.uncertainty[ship] = 0

processor place_ships
  writes: objects, ship_flight
  set objects.routine[0] = first_spaceship
  set objects.routine[1] = second_spaceship
  let corner = 0200000
  set objects.x[0] = corner
  set objects.y[0] = corner
  set corner = -corner
  set objects.x[1] = corner
  set objects.y[1] = corner
  set ship_flight.angle[0] = 0144420                              # pi

# The outlines go into the free core after the table, from its first word.
processor outlines_from_free_core                           # law nnn; dac not
  writes: outline_call, ship_outlines
  set outline_call.code = 0
  set ship_outlines.outline[0] = outline_call.code

processor choose_needle
  writes: outline_call
  set outline_call.table = 0                                # ot1

processor second_outline                                    # a3
  writes: ship_outlines, outline_call
  set ship_outlines.outline[1] = outline_call.code
  set outline_call.table = 010                              # ot2

processor arm_ships
  reads: handoff, tunables
  writes: ship_flight, objects
  let torpedoes = handoff.torpedo_supply
  set ship_flight.torpedoes[0] = torpedoes
  set ship_flight.torpedoes[1] = torpedoes
  let fuel = tunables.fuel_supply
  set ship_flight.fuel[0] = fuel
  set ship_flight.fuel[1] = fuel
  # The calc routine's time for the first frame, before it has run.
  let cycles = 02000
  set objects.cycles[0] = cycles
  set objects.cycles[1] = cycles

processor give_jumps
  reads: handoff
  writes: ships
  let jumps = handoff.hyperspace_shots
  set ships.jumps_left[0] = jumps
  set ships.jumps_left[1] = jumps
