# The `diff` macro, inertia: the acceleration joins the velocity, and an
# eighth of the velocity the position. The original passes the axis as the
# macro's arguments; here each axis is its own Processor. The new position
# is left in AC, where the torpedo takes it up.
processor inertia_x                                         # diff \mdx, mx1, (sar 3s
  in acceleration: word
  inout velocity: word
  inout place: word
  out position: word
  let sum = acceleration + velocity
  set velocity = sum
  set position = (sum >> 3) + place
  set place = position
