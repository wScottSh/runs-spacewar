# The `diff` macro on the y axis: as inertia_x (inertia_x.runs-prim).
processor inertia_y                                         # diff \mdy, my1, (sar 3s
  in acceleration: word
  inout velocity: word
  inout place: word
  out position: word
  let sum = acceleration + velocity
  set velocity = sum
  set position = (sum >> 3) + place
  set place = position
