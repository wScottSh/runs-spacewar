# The outline compiler (oc, source lines 398-507), Dan Edwards' fiddle to
# speed up the spaceship display. Instead of reading a ship's outline every
# frame, the game decodes it once each new game into strokes (outline_code),
# and each frame the spaceship walks them (draw_outline). It is
# presentation. The Networks follow the original's labels; each Processor
# is a run of its instructions between them.
#
# Each direction code is one stroke: a step of the pen, a store or a
# restore of its position, or the end. A begin and a nose come first; the
# end sends the walk back to the nose for the other side, mirrored, then
# leaves the pen at the tail and goes back to the spaceship at sq6.

network compile_outline                                     # jda oc, the outline after the call
  run copy                                         # dap ocg
    source: outline_call.table
    target: outline_compiler.table
  run begin_outline                                         # the first side
    strokes: outline_code.stroke
    code: outline_call.code
  run mark_start                                            # dap ocm: the other side starts here
    code: outline_call.code
    start_over: outline_compiler.start_over
  run start_at_nose                                         # ock: the pen starts at the nose
    strokes: outline_code.stroke
    code: outline_call.code
  run store_first                                           # clf 6: the first 6 code stores
    six: outline_compiler.six
  run take_word                                             # ocj
    words: outlines.codes
    table: outline_compiler.table
    codes_left: outline_compiler.codes_left
    codes: outline_reading.codes
  for code in 1 .. 0140:                                    # och: each code, from the left, until the end
    if code == 1 or outline_reading.direction != 7:         # the passes after the end do nothing
      run take_code
        direction: outline_reading.direction
        codes: outline_reading.codes
        rest: outline_compiler.codes_rest
      if outline_reading.direction == 7:                              # the end
        run end_outline
          strokes: outline_code.stroke
          backs: outline_code.back
          code: outline_call.code
          start_over: outline_compiler.start_over
      elif outline_reading.direction == 0 or outline_reading.direction == 1:  # oc1: down
        run step_down
          strokes: outline_code.stroke
          code: outline_call.code
      elif outline_reading.direction == 2:                            # oc2: out
        run step_out
          strokes: outline_code.stroke
          code: outline_call.code
      elif outline_reading.direction == 3:                            # oc3: out and down
        run step_out_down
          strokes: outline_code.stroke
          code: outline_call.code
      elif outline_reading.direction == 4:                            # oc4: in
        run step_in
          strokes: outline_code.stroke
          code: outline_call.code
      elif outline_reading.direction == 5:                            # oc5: in and down
        run step_in_down
          strokes: outline_code.stroke
          code: outline_call.code
      elif outline_reading.direction == 6:                            # oc6: store, then restore
        if outline_compiler.six == store:                     # szf 6
          run six_stored
            six: outline_compiler.six
          run store_position
            strokes: outline_code.stroke
            code: outline_call.code
        else:
          run six_restored                                    # oc9
            six: outline_compiler.six
          run restore_position
            strokes: outline_code.stroke
            code: outline_call.code
      if outline_reading.direction != 7:
        run copy                                           # lio \oci
          source: outline_compiler.codes_rest
          target: outline_reading.codes
        run count_code                                          # count \occ, och
          codes_left: outline_compiler.codes_left
        if outline_compiler.codes_left >= 0:
          run next_word                                         # idx ocg
            table: outline_compiler.table
          run take_word                                         # jmp ocj
            words: outlines.codes
            table: outline_compiler.table
            codes_left: outline_compiler.codes_left
            codes: outline_reading.codes
