# The ship's outline, its strokes from ship_outlines.outline[slot], which the main
# loop loads into the jump as it reaches the ship's slot. Each step moves
# the pen and plots a dot, from the nose down one side to the end; then the
# out steps are mirrored and the same strokes draw the other side, from the
# nose again. The pen is left at the tail, and the walk goes back to sq6.
processor draw_outline                                      # sp5, jmp .
  in start: word
  in strokes: stroke[0304]
  in backs: word[0304]
  in down_x: word
  in down_y: word
  inout x: word
  inout y: word
  inout out_x: word
  inout out_y: word
  inout out_down_x: word
  inout out_down_y: word
  inout in_down_x: word
  inout in_down_y: word
  inout saved_x: word
  inout saved_y: word
  inout side: side
  out point_x: word
  out point_y: word
  inout points: display
  let at = start
  let drawing = going
  for stroke_count in 1 .. 0304:
    if drawing == going:
      let stroke = strokes[at]
      if stroke == begin:
        set side = first                                  # stf 5
      elif stroke == nose:
        set point_x = x                             # lac \sx1
        set point_y = y                             # lio \sy1
      elif stroke == down:
        set point_x = point_x + down_x
        set (point_x, point_y) = rcl(point_x, point_y, 18)   # swap: only AC adds
        set point_x = point_x - down_y
        set (point_x, point_y) = rcl(point_x, point_y, 18)
        emit points: point_x, point_y, 0
      elif stroke == out:
        set point_x = point_x + out_x
        set (point_x, point_y) = rcl(point_x, point_y, 18)   # swap: only AC adds
        set point_x = point_x + out_y
        set (point_x, point_y) = rcl(point_x, point_y, 18)
        emit points: point_x, point_y, 0
      elif stroke == out_down:
        set point_x = point_x + out_down_x
        set (point_x, point_y) = rcl(point_x, point_y, 18)   # swap: only AC adds
        set point_x = point_x - out_down_y
        set (point_x, point_y) = rcl(point_x, point_y, 18)
        emit points: point_x, point_y, 0
      elif stroke == in:
        set point_x = point_x - out_x
        set (point_x, point_y) = rcl(point_x, point_y, 18)   # swap: only AC adds
        set point_x = point_x - out_y
        set (point_x, point_y) = rcl(point_x, point_y, 18)
        emit points: point_x, point_y, 0
      elif stroke == in_down:
        set point_x = point_x + in_down_x
        set (point_x, point_y) = rcl(point_x, point_y, 18)   # swap: only AC adds
        set point_x = point_x - in_down_y
        set (point_x, point_y) = rcl(point_x, point_y, 18)
        emit points: point_x, point_y, 0
      elif stroke == store:
        set saved_x = point_x
        set saved_y = point_y
      elif stroke == restore:
        set point_x = saved_x
        set point_y = saved_y
      elif stroke == end:
        if side == other:                                 # szf 5
          set x = point_x                           # the tail, where the flame starts
          set y = point_y
          set drawing = done                                # jmp sq6
        if drawing == going:
          set side = other                                  # clf 5: the other side
          # The point is spent: AC and IO carry the mirror's words.
          set point_x = -out_x                        # out is in
          set out_x = point_x
          set point_x = -out_y
          set out_y = point_x
          set point_x = out_down_y                    # out and down is in and down
          set point_y = in_down_y
          set in_down_y = point_x
          set out_down_y = point_y
          set point_x = out_down_x
          set point_y = in_down_x
          set in_down_x = point_x
          set out_down_x = point_y
          set at = backs[at]                        # the nose again
      if stroke != end:
        set at = at + 1
