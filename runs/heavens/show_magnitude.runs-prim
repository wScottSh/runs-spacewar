# The stars of one magnitude (dislis J, Q, B): magnitude m, the stars from
# its first slot up to its past one in the catalog, plotted at its
# intensity.
#
# The sky is 020000 wide and wraps around; the catalog runs right to left.
# The window is the screen's width, 02000, left of the right margin. A scan
# starts at the magnitude's cursor and plots each star in the window. It
# stops at the first star outside the window once it has plotted one, or
# when it has gone all the way round. A star outside the window before any
# is plotted moves the cursor past it, so later scans skip it. star_x and
# star_y are where the star's x and y lie (fin, fyn).
processor show_magnitude(m)
  reads: star_catalog, planetarium
  writes: magnitudes, display
  let scan = looking                                        # clf 5
  let scan_start = magnitudes.cursor[m]                     # lac flo; dap fpo
  let star_x = magnitudes.cursor[m]                         # dap fin
  let star_y = magnitudes.cursor[m]                         # dap fyn
  set star_y = star_y + 1                                   # idx fyn
  let scanning = going
  for star in 1 .. 0672:                                    # fin: each star looked at, once at most (the most a magnitude has)
    if scanning == going:
      let x = star_catalog.words[star_x] - planetarium.right_margin
      if x >= 0:                                            # fgr: round the sky, then test again
        set x = x + (02000 - 020000)
      else:
        set x = x + 02000                                   # from the window's left edge
      if x <= 0:                                            # fuu: outside the window
        if scan == plotted:
          set scanning = done                               # past the window's stars
        if scanning == going:
          set magnitudes.cursor[m] = magnitudes.cursor[m] + 1   # idx flo, idx flo: the next scan
          set magnitudes.cursor[m] = magnitudes.cursor[m] + 1   #   starts after this star
          if magnitudes.cursor[m] == magnitudes.past[m]:
            set magnitudes.cursor[m] = magnitudes.first[m]
      else:
        set x = (x - 01000) << 8                            # to a display coordinate
        emit display: x, star_catalog.words[star_y], magnitudes.intensity[m]
        set scan = plotted                                  # stf 5
    if scanning == going:
      set star_y = star_y + 1                               # fid: the next star
      if star_y == magnitudes.past[m]:                      # flp: past the last star, the first
        if magnitudes.first[m] == scan_start:
          set scanning = done                               # all the way round
        if scanning == going:
          set star_x = magnitudes.first[m]
          set star_y = magnitudes.first[m] + 1
      elif star_y == scan_start:
        set scanning = done                                 # all the way round
      else:
        set star_x = star_y
        set star_y = star_y + 1
