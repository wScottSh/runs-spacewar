# The heavens (source lines 510-653): the central star, and Peter Samson's
# Expensive Planetarium, the background of real stars that drifts slowly
# across the screen. The main loop runs both once a frame, after the
# objects (mq3).
#
# Both are presentation, with one exception: the central star draws two
# random numbers each frame from the generator that also decides hyperspace,
# so its draws are a rule of the game. The planetarium draws none.

# The central star (blp): a short line drawn from the center of the screen
# in a random direction, then mirrored through the center. A new direction
# and length every frame make it spin and flicker. Sense switch 6 turns it
# off, and with it the draws.
network central_star                                        # blp
  if console.no_star == off:                                # szs 60
    run random_step
      number: random.number
    run star_slope                                          # bx, by
      number: random.number
      slope_x: central_star.slope_x
      slope_y: central_star.slope_y
    run star_line                                           # jsp bpt

network star_line                                           # bpt
  run random_step
    number: random.number
  run draw_star
    number: random.number
    slope_x: central_star.slope_x
    slope_y: central_star.slope_y
    points: display

# The Expensive Planetarium (bck), the `background` macro: the stars of the
# catalog, in four magnitudes, through a window one screen wide that moves
# slowly right to left across the sky. It draws every other frame, and moves
# the window one step every 16 of those. Sense switch 4 turns it off.
network expensive_planetarium                               # bck
  if console.no_planetarium == off:                         # szs 40
    run count_frames                                        # isp bcc
      frames: planetarium.alternate_frames
    if planetarium.alternate_frames >= 0:
      run skip_a_frame                                      # law i 2
        frames: planetarium.alternate_frames
      run show_magnitude
        catalog: star_catalog.words
        right_margin: planetarium.right_margin
        first: magnitudes.first[0]
        past: magnitudes.past[0]
        intensity: magnitudes.intensity[0]
        cursor: magnitudes.cursor[0]
        points: display                                 # dislis 1j, 1q, 3
      run show_magnitude
        catalog: star_catalog.words
        right_margin: planetarium.right_margin
        first: magnitudes.first[1]
        past: magnitudes.past[1]
        intensity: magnitudes.intensity[1]
        cursor: magnitudes.cursor[1]
        points: display                                 # dislis 2j, 2q, 2
      run show_magnitude
        catalog: star_catalog.words
        right_margin: planetarium.right_margin
        first: magnitudes.first[2]
        past: magnitudes.past[2]
        intensity: magnitudes.intensity[2]
        cursor: magnitudes.cursor[2]
        points: display                                 # dislis 3j, 3q, 1
      run show_magnitude
        catalog: star_catalog.words
        right_margin: planetarium.right_margin
        first: magnitudes.first[3]
        past: magnitudes.past[3]
        intensity: magnitudes.intensity[3]
        cursor: magnitudes.cursor[3]
        points: display                                 # dislis 4j, 4q, 0
      run count_steps                                       # isp bkc
        steps: planetarium.window_steps
      if planetarium.window_steps >= 0:
        run move_window
          steps: planetarium.window_steps
          right_margin: planetarium.right_margin
