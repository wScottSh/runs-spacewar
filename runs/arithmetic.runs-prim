# The arithmetic subroutines and the macros. Each is a Processor over the
# Records it hands its values through.

# BBN integer square root (sqt), over its own words. Binary point right of
# bit 17 in square_root_call.entry, between bits 8 and 9 in .root. Two bits
# of input per pass, 18 passes: passes_left counts up from -022 to 0, one
# pass a count.
processor square_root                                       # sqt
  writes: square_root_call
  set square_root_call.passes_left = -023
  set square_root_call.root = 0
  let input_bits = square_root_call.entry
  set square_root_call.entry = 0
  set square_root_call.passes_left = square_root_call.passes_left + 1
  if square_root_call.passes_left < 0:
    for pass in 1 .. -square_root_call.passes_left:
      set square_root_call.root = square_root_call.root << 1
      let next = square_root_call.entry
      set (next, input_bits) = rcl(next, input_bits, 2)
      if next != 0:
        set square_root_call.entry = next
        set next = (square_root_call.root << 1) + 1 - square_root_call.entry
        if next <= 0:
          if next < 0:
            set next = -next
          set square_root_call.entry = next
          set square_root_call.root = square_root_call.root + 1
      set square_root_call.passes_left = square_root_call.passes_left + 1

# The `random` macro: the generator's next value.
processor next_random
  writes: random
  set random.number = (rar(random.number, 1) ^ 0355670) + 0355670

# The `diff` macro, inertia: the acceleration joins the velocity, and an
# eighth of the velocity the position. The original passes the axis as the
# macro's arguments; here each axis is its own Processor. The new position
# is left in AC, where the torpedo takes it up.
processor inertia_x                                         # diff \mdx, mx1, (sar 3s
  in acceleration: word
  inout velocity: word
  inout place: word
  out position: word
  let sum = acceleration + velocity
  set velocity = sum
  set position = (sum >> 3) + place
  set place = position

processor inertia_y                                         # diff \mdy, my1, (sar 3s
  in acceleration: word
  inout velocity: word
  inout place: word
  out position: word
  let sum = acceleration + velocity
  set velocity = sum
  set position = (sum >> 3) + place
  set place = position
