# The explosion's calc routine (mex). It is not a network file yet: its dots
# are a loop whose count the game computes, which a network file cannot
# state (no fold transition), and its dots are emitted by Processors that
# name the display. The torpedo, in_hyperspace and breakout are network
# files beside it in objects/.

# An exploding object keeps drifting and is drawn as a cloud of dots, one
# per 8 instructions of its size, for as many frames as its counter has
# left; then its slot is freed.
network explosion(slot)                                     # mex
  run coast                                                 # cla
  run inertia
    acceleration: handoff.acceleration
    velocity: objects.dx[slot]
    place: objects.x[slot]
    position: handoff.position
  run coast                                                 # cla
  run inertia
    acceleration: handoff.acceleration
    velocity: objects.dy[slot]
    place: objects.y[slot]
    position: handoff.position
  run spread_particles
  run size_explosion(slot)
  run widen_spread
  run random_step                                           # mz1
    number: random.number
  run scatter_particle                                      # dac mi1
  run random_step
    number: random.number
  run plot_particle(slot)
  run count_particle                                        # count \mxc, mz1
  if explosion_count.particles < 0:                         # one dot a count
    for dot in 1 .. -explosion_count.particles:
      run random_step
        number: random.number
      run scatter_particle
      run random_step
        number: random.number
      run plot_particle(slot)
      run count_particle
  run count_down                                      # count i ma1, mxr
    counter: objects.counter[slot]
  if objects.counter[slot] >= 0:
    run free_slot(slot)
