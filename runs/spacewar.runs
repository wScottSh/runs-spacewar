# Spacewar! 3.1: the game's state.
#
# Every word of core the game carries from one routine to another, or from
# one frame to the next, is a field of a Record here. So is every value that
# passes between two Processors. Scratch words a Processor sets before it
# reads them, and never hands on, are locals of the Processor.

type word
  bits: 18
  complement: ones          # -0 exists; add and subtract are the PDP-1's (end-around carry, never yield -0)
  compare: sign             # word < 0 tests the sign bit; == compares all 18 bits

# The routine word (the ml1 property): which calc routine runs the object.
# Each value also fixes whether the object collides; core keeps that in the
# word's sign bit.
enum calc_routine
  none                      # a free slot
  first_spaceship           # ss1
  second_spaceship          # ss2
  torpedo                   # tcr
  explosion                 # mex: does not collide
  in_hyperspace             # hp1: does not collide
  breakout                  # hp3

# The object table (mtb): two spaceships, then 22 torpedoes. It is the
# interface: the game writes it, and the drawing reads what each object is,
# where it is, and an explosion's size.
interface record objects[030]
  routine: calc_routine = none
  x: word = 0               # nx1: position
  y: word = 0               # ny1
  counter: word = 0         # na1: frames left of a torpedo's life, an explosion, a stay in hyperspace
  cycles: word = 0          # nb1: instructions the calc routine takes; an explosion's size
  dx: word = 0              # ndx: velocity
  dy: word = 0              # ndy

# Spaceship-only properties, slot for slot with objects[0] and objects[1],
# in the table's order: how each ship flies, where its outline's strokes
# start, then the rest.
game record ship_flight[2]
  angular_momentum: word = 0    # nom
  angle: word = 0               # nth: heading
  fuel: word = 0                # nfu: counting up, out at 0
  torpedoes: word = 0           # ntr: torpedoes left, counting up

presentation record ship_outlines[2]
  outline: word = 0             # not: where the ship's outline strokes start

game record ships[2]
  previous_control: word = 0    # nco: last frame's control word
  saved_routine: calc_routine = none   # nh1: the ship's own calc routine, kept during hyperspace
  jumps_left: word = 0          # nh2: hyperspace jumps left, counting up
  recharge: word = 0            # nh3: hyperfield generator recharge, counting up
  uncertainty: word = 0         # nh4: hyperspatial uncertainty

interface record random
  number: word = 0          # ran

# The frame's instruction budget. It is pacing: the spare-time loop burns
# what the objects left of it, and no rule reads it, so it is presentation.
presentation record pacing
  spare_time: word = 0      # mtc: the frame's instruction budget, counting up

game record frame
  restart_delay: word = 0   # ntd: frames until the next game, counting up. The tape does not
                            # load it, but every game sets it before it counts it down.
  objects_seen: word = 0    # moc: counted, never read. The tape does not load it, so on the
                            # PDP-1 it counts up from core's power-on contents (reach_oracle).

# The scores, and the games left in the match. The tape does not load these
# words, and the first game reads them before it sets them, so the first
# match starts from whatever core held at power-on. They come in at the
# boundary: no initial value.
interface record score
  first: word               # 1sc
  second: word              # 2sc
  games_left: word          # gct: counting up; 0 when no match is on

# A switch on the console.
enum switch
  off
  on

# What the operator and the players set at the console. It comes in.
interface record console
  test_word: word           # the test word switches: the controls when started at 5, the
                            # match's setup, and whether to halt and show the scores
  control_boxes: word       # the control boxes' buttons
  # The sense switches, each named for what it does when on.
  angular_momentum: switch  # 1: the rotate buttons build up angular momentum
  light_star: switch        # 2: the central star pulls less
  single_shot: switch       # 3: a torpedo only for each new press of the fire button
  no_planetarium: switch    # 4: no Expensive Planetarium
  star_kills: switch        # 5: a ship that falls into the star explodes
  no_star: switch           # 6: no central star, and no gravity

# Where each frame's control word comes from: the start address picks it.
enum control_source
  test_word                 # mg2
  control_boxes             # cwr, the control word routine: the boxes, or the operator's own

interface record controls
  source: control_source    # cwg: set at the start, before any frame reads it

# Program flags 1 and 2 light on the console for the ship that survived a
# game. Flag 2 goes out again at once, and nothing reads them.
enum light
  off
  on

interface record lights
  first_survived: light     # program flag 1
  second_survived: light    # program flag 2

# The scores, shown on the console lights while the machine waits between
# games. They leave the game; the top Networks' contracts declare them.
presentation stream scoreboard
  first: word               # AC
  second: word              # IO

# The ship outlines are presentation. At each new game the outline compiler
# (oc) decodes each outline into strokes (outline_code), and each frame a
# spaceship walks its own (draw_outline). ship_outlines.outline keeps where each
# ship's strokes start.

# The ships' outlines (ot1, ot2), what the compiler reads. Each word holds
# six 3-bit direction codes, read from the left, that trace one side of a
# ship from its nose down to its tail, as it stands on its tail:
#   0, 1 down   2 out   3 out and down   4 in   5 in and down
#   6 store the pen's position, and at the next 6 restore it
#   7 the end: draw the other side, then go back to the spaceship
presentation record outlines[020]
  codes: word =
    0111131                 # ot1: the needle, the first ship's
    0111111
    0111111
    0111163
    0311111
    0146111
    0111114
    0700000
    0013113                 # ot2: the wedge, the second ship's, and the first's when they share
    0113111
    0116313
    0131111
    0161151
    0111633
    0365114
    0700000

# An outline decoded, one stroke a direction code: what the walk does at
# each. The first side begins, then each side starts at the nose, takes the
# outline's steps and stores and restores, and ends. The strokes lie in the
# free core after the object table (nnn). The tape does not load them, and
# a new game decodes the outlines into them before anything walks them.
enum stroke
  begin                     # the first side begins
  nose                      # a side starts at the nose
  down                      # 0, 1
  out                       # 2
  out_down                  # 3
  in                        # 4
  in_down                   # 5
  store                     # 6, the first of a pair
  restore                   # 6, the second
  end                       # 7: the other side, or the end of the outline

# Two outlines, each a begin, a nose and at most 0140 codes.
presentation record outline_code[0304]
  stroke: stroke
  back: word                # an end's nose: where the other side starts

presentation record outline_call
  code: word = 0            # oc's entry word: where in outline_code the next stroke goes; at
                            #   the end, the slot after the outline
  table: word = 0           # the word after the call: where in outlines the outline starts

# What the next 6 code of an outline compiles.
enum six_code
  store
  restore

# The outline compiler's own words.
presentation record outline_compiler
  table: word = 0           # ocg: the outline word it reads, a place in outlines
  codes_left: word = 0      # occ: codes still to read in that word, counting up
  codes_rest: word = 0      # oci: the word, rotated past the codes read
  six: six_code = store     # program flag 6
  start_over: word = 0      # ocm: where the outline's nose is, where the other side starts

# The central star's line: how far each dot moves along x and along y.
# Each is the sign and the three bits just below a display coordinate, so a
# dot moves less than one point.
presentation record central_star
  slope_x: word = 0         # bx
  slope_y: word = 0         # by

# Whether a loop of a fixed count is still at work. Once done, the passes
# left do nothing: that is how a loop leaves early on a value it computes.
enum progress
  going
  done

# Which half of the central star's line is drawn (program flag 6).
enum half
  first
  mirrored

# The Expensive Planetarium's own words: it draws every other frame, and
# moves its window one step left every 16 of those.
presentation record planetarium
  alternate_frames: word = 0    # bcc: counting up
  window_steps: word = 0        # bkc: counting up
  right_margin: word = 010000   # fpr: the sky's x at the right edge of the screen

# The catalog's four magnitudes, brightest first: where each one's stars
# lie in star_catalog.words, how bright the scope plots them, and where its
# next scan starts.
presentation record magnitudes[4]
  first: word =             # J: the magnitude's first star
    0                       # 1j
    022                     # 2j
    044                     # 3j
    0306                    # 4j
  past: word =              # Q+2: the slot after its last star
    022
    044
    0306
    01652
  intensity: int =          # B: 3 is the brightest
    3
    2
    1
    0
  cursor: word =            # flo: where the next scan starts
    0                       # the first magnitude's first star (1j)
    022                     # the second's (2j)
    044                     # the third's (3j)
    0306                    # the fourth's (4j)

# Whether a scan of the stars has plotted one yet (program flag 5).
enum scan
  looking
  plotted

# The "interesting and often changed constants" at the head of the tape.
# The ones the original keeps as instructions to execute are Processors in
# tunables.runs-prim; these are the ones it keeps as numbers. The game's:
# the fuel, the turn, the star's capture, the collisions and hyperspace
# read them, and nothing the presentation runs does.
game record tunables
  fuel_supply: word = -020000               # foo
  angular_acceleration: word = 010          # maa: spaceship angular acceleration
  star_capture_radius: word = 1             # str
  collision_radius: word = 06000            # me1
  collision_radius_half: word = 03000       # me2
  hyperspatial_uncertainty: word = 040000   # hur

# The tunable only the outlines read: whether each ship has its own.
presentation record outline_setting
  separate_outlines: word = -0              # ddd: -0 compiles an outline for each ship; 0 shares one

# What the scope shows: each point in the order it is plotted. It leaves the
# game; the frame Network's contract declares it.
presentation stream display
  x: word
  y: word
  intensity: int

# How many dots the explosion has left this frame. The game counts them:
# each dot draws two random numbers from the generator hyperspace also
# draws from, so the count decides what hyperspace later draws. The
# presentation reads it to choose the cloud's spread.
interface record explosion_count
  particles: word = 0       # mxc: dots left to plot, counting up

# The explosion's cloud, carried from one dot to the next.
presentation record explosion_cloud
  spread: word = 0          # msh: which of mst's shifts spreads the dots, scr 1s or scr 3s
  scatter: word = 0         # mi1: places the scl built from a random number shifts this dot

# The integer square root's own words.
game record square_root_call
  entry: word = 0           # sqt: jda leaves the argument here; it doubles as the remainder
  passes_left: word = 0     # sq1
  root: word = 0            # sq2: the result

# Whether a quotient fits a word. The caller sees it as a skip: dvd and idv
# return past one more word when it fits.
enum division
  fits
  overflows                 # |high dividend| >= |divisor|

# The divide subroutines' own words (dvd, idv). The divisor is the word after
# the call, like multiply's second factor.
game record divide_call
  high: word = 0            # dvd: jda leaves the dividend's high half here; the remainder at return
  low: word = 0             # IO: the dividend's low half
  divisor: word = 0
  quotient: word = 0        # idv: |divisor|, then the quotient's magnitude
  result: word = 0          # AC at return: the quotient, or |divisor| signed like one on overflow
  outcome: division = overflows

game record integer_divide_call
  dividend: word = 0        # idv: jda leaves the dividend here
  low: word = 0             # IO on entry: its sign lands in the low half's lowest bit
  divisor: word = 0

# The sine-cosine subroutine's own words (sin, cos). The series keeps its
# working values in the two entry words.
game record sine_call
  angle: word = 0           # sin: jda leaves the angle here, binary point right of bit 3
  x: word = 0               # sin, later: the angle reduced to [0, pi/2], times 2/pi
  x_squared: word = 0       # cos, later
  answer: word = 0          # cos, last: the series' answer
  result: word = 0          # AC at return, binary point right of bit 0

game record cosine_call
  angle: word = 0           # cos: jda leaves the angle here

# The spaceship calc routine's own words, handed from one of its rules to the
# next within one ship's turn.
enum rocket
  off
  firing

# The ship's heading as the game computes it this turn. Both sides need
# it: the game aims thrust and torpedoes with it, the presentation aims the
# outline and the exhaust flame.
interface record heading
  sine: word = 0            # sn
  cosine: word = 0          # cs

# The ship's nose as the game computes it this turn, a 32nd of the heading
# ahead of its center. The game starts a torpedo ahead of it; the
# presentation draws the outline from it.
interface record ship_nose
  x: word = 0               # sx1
  y: word = 0               # sy1

game record spaceship
  controls: word = 0        # scw: this ship's control word, its four bits at the top
  rocket: rocket = off      # program flag 6: the rocket fires this frame
  gravity_x: word = 0       # bx: the star's pull this frame
  gravity_y: word = 0       # by
  operand: word = 0         # t1: a scaled coordinate, then the squared distance, then the
                            #   distance cubed: the word after a call (jda imp / lac \t1)
  x_squared: word = 0       # t2
  nose_step_x: word = 0     # ssn: a 32nd of the heading, from the center to the nose
  nose_step_y: word = 0     # scn
  torpedo_x: word = 0       # stx: where a torpedo starts, ahead of the ship's tip
  torpedo_y: word = 0       # sty
  flame: word = 0           # src: exhaust dots still to draw, counting up
  star_wait: word = 0       # ssn: the count a ship in the star waits out

# Which side of a ship's outline is drawn: the first, then the other,
# mirrored.
enum side
  other
  first

# Where a ship's outline is drawn from, and the steps it is drawn with. The
# outline is presentation: the spaceship sets these and walks its outline's
# strokes (ship_outlines.outline), which plots the ship, leaves the pen at the
# ship's tail, where the exhaust flame starts, and leaves the out steps
# mirrored for the ship's other side. The steps are the heading scaled down
# by 2^9, turned to each direction of a ship standing on its tail.
presentation record pen
  x: word = 0               # sx1
  y: word = 0               # sy1
  down_x: word = 0          # ssn: added to x
  down_y: word = 0          # scn: subtracted from y
  out_x: word = 0           # scm: added to x
  out_y: word = 0           # ssm: added to y
  out_down_x: word = 0      # ssc: added to x
  out_down_y: word = 0      # csm: subtracted from y
  in_down_x: word = 0       # csn: added to x
  in_down_y: word = 0       # ssd: subtracted from y
  saved_x: word = 0         # ssa: where a 6 code stores the pen, and the next restores it
  saved_y: word = 0         # ssi
  side: side = other        # program flag 5: which side of the outline the walk draws

# Whether a ship breaking out of hyperspace survives: the margin by which a
# random number outweighs its uncertainty.
game record breakout_check
  margin: word = 0          # AC at hp5's spa

# A new torpedo's slot: the first free one of the object table.
game record launch
  slot: word = 0            # sr1: kept in the search's cursor

# Values the original hands from one rule to the next in AC and IO. Each is a
# place only because a register carried it: into or out of a tunable the
# original executes with xct, or into the diff macro.
game record handoff
  coordinate: word = 0      # AC into `the`: a torpedo's coordinate, sar 9s
  acceleration: word = 0    # AC into diff: from `the`, or 0 (cla)
  position: word = 0        # AC out of diff: the new position
  explosion_low: word = 0   # IO: cleared with the count's cma (cli); the dots shift it out unread
  jump_high: word = 0       # AC: hyperspace's random draw into and out of hr1, hr2;
  jump_low: word = 0        # IO:   one 36-bit value, scaled as one. IO holds what the main
                            #   loop left there when hyperspace begins; the draw pushes it out
  torpedo_direction: word = 0   # AC into tvl: the sine or cosine of the ship's heading
  torpedo_velocity: word = 0    # AC out of tvl
  thrust_direction: word = 0    # AC into sac: the sine or cosine of the heading, sar 9s
  thrust: word = 0              # AC out of sac
  torpedo_supply: word = 0  # AC out of tno
  reload_time: word = 0     # AC out of rlt
  torpedo_life: word = 0    # AC out of tlf
  hyperspace_shots: word = 0    # AC out of mhs
  hyperspace_time: word = 0     # AC out of hd1
  breakout_time: word = 0   # AC out of hd2
  recharge_time: word = 0   # AC out of hd3
  control_word: word = 0    # IO out of the control word routine (jsp i \cwg)
  capture_margin: word = 0  # AC: a ship's squared distance from the star, less the capture radius
  distance_high: word = 0   # AC:IO: the distance from the star cubed, scaled down; a ship
  distance_low: word = 0    #   feels gravity only when the high half is 0
  torpedo_button: word = 0  # AC: the fire button, if it counts as pressed, in the sign bit
  rocket_button: word = 0   # IO: the control word rotated, the rocket button in the sign bit
  hyperspace_buttons: word = 0  # AC: the rotate buttons not newly pressed; 0 when both are
  torpedoes_left: word = 0  # AC: 1 + a ship's torpedo count, below 0 while it has one to fire
  scores_switch: word = 0   # AC: test word switch 040, which halts between games to show the scores

# The explosion's dot in AC and IO: IO carries the low half from one dot's
# shifts to the next; the high half is the dot's own local.
presentation record explosion_dot
  low: word = 0             # IO: each dot's y

# The outline compiler's carries in AC and IO.
presentation record outline_reading
  codes: word = 0           # IO: the outline word, rotated
  direction: word = 0       # AC: the next direction code, which the compiler dispatches on

# The point the outline's walk is at, carried in AC and IO.
presentation record outline_point
  x: word = 0               # AC
  y: word = 0               # IO
