# multiply (mpy). Places are Record fields; transitions are Processors.
# One arc a line: place -> transition.input, or transition.output -> place.
# A guard arc: place -> transition when <test>. No line's position means anything.

network multiply

places
  multiply_steps_work.high_0
  multiply_steps_work.high_1
  multiply_steps_work.high_2
  multiply_steps_work.high_3
  multiply_steps_work.high_4
  multiply_steps_work.high_5
  multiply_steps_work.high_6
  multiply_steps_work.high_7
  multiply_steps_work.high_8
  multiply_steps_work.high_9
  multiply_steps_work.high_10
  multiply_steps_work.high_11
  multiply_steps_work.high_12
  multiply_steps_work.high_13
  multiply_steps_work.high_14
  multiply_steps_work.high_15
  multiply_steps_work.high_16
  multiply_steps_work.low_1
  multiply_steps_work.low_2
  multiply_steps_work.low_3
  multiply_steps_work.low_4
  multiply_steps_work.low_5
  multiply_steps_work.low_6
  multiply_steps_work.low_7
  multiply_steps_work.low_8
  multiply_steps_work.low_9
  multiply_steps_work.low_10
  multiply_steps_work.low_11
  multiply_steps_work.low_12
  multiply_steps_work.low_13
  multiply_steps_work.low_14
  multiply_steps_work.low_15
  multiply_steps_work.low_16
  multiply_call.entry
  multiply_call.factor
  multiply_call.partial
  multiply_call.low
  multiply_work.entry_magnitude
  multiply_work.factor_magnitude
  multiply_work.high
  multiply_work.low
  multiply_work.saved_high
  multiply_work.signs
  multiply_work.reloaded_high
  multiply_work.negated_high

transitions
  clear_high: clear
  step_1: multiply_step
  step_2: multiply_step
  step_3: multiply_step
  step_4: multiply_step
  step_5: multiply_step
  step_6: multiply_step
  step_7: multiply_step
  step_8: multiply_step
  step_9: multiply_step
  step_10: multiply_step
  step_11: multiply_step
  step_12: multiply_step
  step_13: multiply_step
  step_14: multiply_step
  step_15: multiply_step
  step_16: multiply_step
  step_17: multiply_step
  magnitude_of_entry: magnitude
  magnitude_of_factor: magnitude
  save_high: copy
  sign_of_product: exclusive_or
  reload_high: copy
  negate: negate_double
  give_negated_high: copy
  give_high: copy
  give_low: copy

arcs
  clear_high.value -> multiply_steps_work.high_0
  multiply_work.entry_magnitude -> step_1.low
  multiply_work.factor_magnitude -> step_1.multiplicand
  multiply_steps_work.high_0 -> step_1.high
  step_1.low -> multiply_steps_work.low_1
  step_1.high -> multiply_steps_work.high_1
  multiply_steps_work.low_1 -> step_2.low
  multiply_work.factor_magnitude -> step_2.multiplicand
  multiply_steps_work.high_1 -> step_2.high
  step_2.low -> multiply_steps_work.low_2
  step_2.high -> multiply_steps_work.high_2
  multiply_steps_work.low_2 -> step_3.low
  multiply_work.factor_magnitude -> step_3.multiplicand
  multiply_steps_work.high_2 -> step_3.high
  step_3.low -> multiply_steps_work.low_3
  step_3.high -> multiply_steps_work.high_3
  multiply_steps_work.low_3 -> step_4.low
  multiply_work.factor_magnitude -> step_4.multiplicand
  multiply_steps_work.high_3 -> step_4.high
  step_4.low -> multiply_steps_work.low_4
  step_4.high -> multiply_steps_work.high_4
  multiply_steps_work.low_4 -> step_5.low
  multiply_work.factor_magnitude -> step_5.multiplicand
  multiply_steps_work.high_4 -> step_5.high
  step_5.low -> multiply_steps_work.low_5
  step_5.high -> multiply_steps_work.high_5
  multiply_steps_work.low_5 -> step_6.low
  multiply_work.factor_magnitude -> step_6.multiplicand
  multiply_steps_work.high_5 -> step_6.high
  step_6.low -> multiply_steps_work.low_6
  step_6.high -> multiply_steps_work.high_6
  multiply_steps_work.low_6 -> step_7.low
  multiply_work.factor_magnitude -> step_7.multiplicand
  multiply_steps_work.high_6 -> step_7.high
  step_7.low -> multiply_steps_work.low_7
  step_7.high -> multiply_steps_work.high_7
  multiply_steps_work.low_7 -> step_8.low
  multiply_work.factor_magnitude -> step_8.multiplicand
  multiply_steps_work.high_7 -> step_8.high
  step_8.low -> multiply_steps_work.low_8
  step_8.high -> multiply_steps_work.high_8
  multiply_steps_work.low_8 -> step_9.low
  multiply_work.factor_magnitude -> step_9.multiplicand
  multiply_steps_work.high_8 -> step_9.high
  step_9.low -> multiply_steps_work.low_9
  step_9.high -> multiply_steps_work.high_9
  multiply_steps_work.low_9 -> step_10.low
  multiply_work.factor_magnitude -> step_10.multiplicand
  multiply_steps_work.high_9 -> step_10.high
  step_10.low -> multiply_steps_work.low_10
  step_10.high -> multiply_steps_work.high_10
  multiply_steps_work.low_10 -> step_11.low
  multiply_work.factor_magnitude -> step_11.multiplicand
  multiply_steps_work.high_10 -> step_11.high
  step_11.low -> multiply_steps_work.low_11
  step_11.high -> multiply_steps_work.high_11
  multiply_steps_work.low_11 -> step_12.low
  multiply_work.factor_magnitude -> step_12.multiplicand
  multiply_steps_work.high_11 -> step_12.high
  step_12.low -> multiply_steps_work.low_12
  step_12.high -> multiply_steps_work.high_12
  multiply_steps_work.low_12 -> step_13.low
  multiply_work.factor_magnitude -> step_13.multiplicand
  multiply_steps_work.high_12 -> step_13.high
  step_13.low -> multiply_steps_work.low_13
  step_13.high -> multiply_steps_work.high_13
  multiply_steps_work.low_13 -> step_14.low
  multiply_work.factor_magnitude -> step_14.multiplicand
  multiply_steps_work.high_13 -> step_14.high
  step_14.low -> multiply_steps_work.low_14
  step_14.high -> multiply_steps_work.high_14
  multiply_steps_work.low_14 -> step_15.low
  multiply_work.factor_magnitude -> step_15.multiplicand
  multiply_steps_work.high_14 -> step_15.high
  step_15.low -> multiply_steps_work.low_15
  step_15.high -> multiply_steps_work.high_15
  multiply_steps_work.low_15 -> step_16.low
  multiply_work.factor_magnitude -> step_16.multiplicand
  multiply_steps_work.high_15 -> step_16.high
  step_16.low -> multiply_steps_work.low_16
  step_16.high -> multiply_steps_work.high_16
  multiply_steps_work.low_16 -> step_17.low
  multiply_work.factor_magnitude -> step_17.multiplicand
  multiply_steps_work.high_16 -> step_17.high
  step_17.low -> multiply_work.low
  step_17.high -> multiply_work.high
  multiply_call.entry -> magnitude_of_entry.value
  magnitude_of_entry.magnitude -> multiply_work.entry_magnitude
  multiply_call.factor -> magnitude_of_factor.value
  magnitude_of_factor.magnitude -> multiply_work.factor_magnitude
  multiply_work.high -> save_high.source
  save_high.target -> multiply_work.saved_high
  multiply_call.factor -> sign_of_product.a
  multiply_call.entry -> sign_of_product.b
  sign_of_product.result -> multiply_work.signs
  multiply_work.signs -> reload_high when < 0
  multiply_work.saved_high -> reload_high.source
  reload_high.target -> multiply_work.reloaded_high
  multiply_work.reloaded_high -> negate.high
  multiply_work.low -> negate.low
  negate.high -> multiply_work.negated_high
  negate.low -> multiply_call.low
  multiply_work.negated_high -> give_negated_high.source
  give_negated_high.target -> multiply_call.partial
  multiply_work.signs -> give_high when else
  multiply_work.saved_high -> give_high.source
  give_high.target -> multiply_call.partial
  multiply_work.signs -> give_low when else
  multiply_work.low -> give_low.source
  give_low.target -> multiply_call.low
