  x: word = 0
  x_low: word = 0
  x_squared: word = 0
  x_squared_low: word = 0
  c7: word = 0
  term_7: word = 0
  term_7_low: word = 0
  sum_5: word = 0
  term_5: word = 0
  term_5_low: word = 0
  sum_3: word = 0
  term_3: word = 0
  term_3_low: word = 0
  sum_1: word = 0
  term_1: word = 0
  term_1_low: word = 0
  answer: word = 0
  overshoot: word = 0
