# cosine (cos): cos a = sin(a + pi/2). sine is one transition, wired as a
# Processor is.

network cosine
  in angle: word
  out result: word

places
  cosine_work.shifted

transitions
  shift: add_half_pi
  sine: sine

arcs
  angle -> shift.angle
  shift.shifted -> cosine_work.shifted
  cosine_work.shifted -> sine.angle
  sine.result -> result
