processor reduce_angle                                      # sin .. si3: the angle folded into [0, pi/2]
  in angle: word
  out reduced: word
  let a = angle
  if a < 0:
    set a = a + 0311040                                     # si1
  loop at most 2:                                           # two passes reduce every word (all 2^18 run)
    set a = a - 062210
    if a < 0:
      set a = a + 062210
      break
    set a = -a + 062210                                     # si2: fold past pi/2 back
    if a >= 0:
      break
    set a = a + 062210
    if a >= 0:
      set a = a - 062210
      break
    set a = a - 062210
    set a = a + 0311040                                     # jmp si1
  set reduced = ral(a, 2)                                   # si3
