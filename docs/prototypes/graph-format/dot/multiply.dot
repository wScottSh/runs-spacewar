// multiply (mpy) in Graphviz DOT: `dot -Tsvg multiply.dot` draws the net.
// Circles are places (Record fields), boxes are transitions (labeled with
// their Processor). An arc's label is the Processor's input or output; a
// dashed arc is a guard. No statement's position means anything.
digraph multiply {
  node [shape=circle]
  "multiply_call.entry"; "multiply_call.factor"; "multiply_call.partial"; "multiply_call.low"
  "multiply_work.entry_magnitude"; "multiply_work.factor_magnitude"
  "multiply_work.high"; "multiply_work.low"; "multiply_work.saved_high"; "multiply_work.signs"
  "multiply_work.reloaded_high"; "multiply_work.negated_high"

  node [shape=box]
  magnitude_of_entry [label=magnitude]
  magnitude_of_factor [label=magnitude]
  steps [label=multiply_steps]
  save_high [label=copy]
  sign_of_product [label=exclusive_or]
  reload_high [label=copy]
  negate [label=negate_double]
  give_negated_high [label=copy]
  give_high [label=copy]
  give_low [label=copy]

  "multiply_call.entry" -> magnitude_of_entry [label=value]
  magnitude_of_entry -> "multiply_work.entry_magnitude" [label=magnitude]
  "multiply_call.factor" -> magnitude_of_factor [label=value]
  magnitude_of_factor -> "multiply_work.factor_magnitude" [label=magnitude]
  "multiply_work.entry_magnitude" -> steps [label=low]
  "multiply_work.factor_magnitude" -> steps [label=multiplicand]
  steps -> "multiply_work.high" [label=high]
  steps -> "multiply_work.low" [label=low]
  "multiply_work.high" -> save_high [label=source]
  save_high -> "multiply_work.saved_high" [label=target]
  "multiply_call.factor" -> sign_of_product [label=a]
  "multiply_call.entry" -> sign_of_product [label=b]
  sign_of_product -> "multiply_work.signs" [label=result]
  "multiply_work.signs" -> reload_high [label="< 0", style=dashed]
  "multiply_work.saved_high" -> reload_high [label=source]
  reload_high -> "multiply_work.reloaded_high" [label=target]
  "multiply_work.reloaded_high" -> negate [label=high]
  "multiply_work.low" -> negate [label=low]
  negate -> "multiply_work.negated_high" [label=high]
  negate -> "multiply_call.low" [label=low]
  "multiply_work.negated_high" -> give_negated_high [label=source]
  give_negated_high -> "multiply_call.partial" [label=target]
  "multiply_work.signs" -> give_high [label=else, style=dashed]
  "multiply_work.saved_high" -> give_high [label=source]
  give_high -> "multiply_call.partial" [label=target]
  "multiply_work.signs" -> give_low [label=else, style=dashed]
  "multiply_work.low" -> give_low [label=source]
  give_low -> "multiply_call.low" [label=target]
}
