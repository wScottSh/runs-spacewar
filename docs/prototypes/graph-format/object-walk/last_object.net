# The last slot. It has no later object to test, and it is not counted.

network last_object(slot)
  inout table: objects

places
  calculated: objects

transitions
  calc: calc(slot)
  charge: charge_time(slot)
  give: copy
  idle: copy

arcs
  table[slot].routine -> calc when != none
  table -> calc.table
  calc.table -> calculated
  calculated[slot].cycles -> charge
  calculated -> give.source
  give.target -> table
  table[slot].routine -> idle when else
  table -> idle.source
  idle.target -> table
