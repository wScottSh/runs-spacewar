# A torpedo (tcr) flies straight, bent only by the torpedo space warpage,
# until its life runs out and it explodes.

network torpedo(slot)                                       # tcr
  inout table: objects

places
  counted: word
  coordinate_x: word
  pull_y: word
  moved_y: word
  position_y: word
  coordinate_y: word
  pull_x: word
  moved_x: word
  position_x: word

transitions
  count: count_down                                         # count i ma1, tc1
  explode: explode_torpedo
  warp_x: warp_from_x                                       # tc1
  warpage_y: torpedo_space_warpage
  move_y: inertia_y
  warp_y: warp_from_y
  warpage_x: torpedo_space_warpage
  move_x: inertia_x
  show: plot_torpedo(slot)
  give_counter: copy
  give_x: copy
  give_y: copy

arcs
  table[slot].counter -> count.counter
  count.counter -> counted
  counted -> explode when >= 0
  explode.routine -> table[slot].routine
  explode.counter -> table[slot].counter
  counted -> warp_x when else
  table[slot].x -> warp_x.x
  warp_x.coordinate -> coordinate_x
  coordinate_x -> warpage_y.coordinate
  warpage_y.acceleration -> pull_y
  pull_y -> move_y.acceleration
  table[slot].dy -> move_y.velocity
  table[slot].y -> move_y.place
  move_y.velocity -> table[slot].dy
  move_y.place -> moved_y
  move_y.position -> position_y
  position_y -> warp_y.position
  warp_y.coordinate -> coordinate_y
  coordinate_y -> warpage_x.coordinate
  warpage_x.acceleration -> pull_x
  pull_x -> move_x.acceleration
  table[slot].dx -> move_x.velocity
  table[slot].x -> move_x.place
  move_x.velocity -> table[slot].dx
  move_x.place -> moved_x
  move_x.position -> position_x
  moved_x -> show
  moved_y -> show
  counted -> give_counter when else
  counted -> give_counter.source
  give_counter.target -> table[slot].counter
  moved_x -> give_x.source
  give_x.target -> table[slot].x
  moved_y -> give_y.source
  give_y.target -> table[slot].y
